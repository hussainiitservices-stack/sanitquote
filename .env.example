# Supabase project URL, for example https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon key. Safe to expose to the browser. RLS still applies.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key. Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Public origin used for auth redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Personal access token for the Supabase CLI and migrations. Never commit a real value.
SUPABASE_ACCESS_TOKEN=
